generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SALES_MANAGER
  INVENTORY_MANAGER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COLLECTING
  PACKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED_BY_STORE
  CANCELLED_BY_CUSTOMER
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum InventoryReason {
  ONLINE_ORDER
  STORE_SALE
  RESTOCK
  ADJUSTMENT
  DAMAGE
  RETURN
  PERSONAL_USE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REFUNDING
  REFUNDED
  REJECTED
}

model User {
  id                 String                    @id @default(cuid())
  name               String?
  email              String?                   @unique
  phone              String?                   @unique
  passwordHash       String?
  role               Role                      @default(CUSTOMER)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  addresses          Address[]
  orders             Order[]
  favorites          Favorite[]
  reviews            Review[]
  questions          ProductQuestion[]
  loyalty            LoyaltyTransaction[]
  referralCodes      ReferralCode[]
  referralRewardsOut ReferralReward[]          @relation("ReferrerRewards")
  referralRewardsIn  ReferralReward[]          @relation("ReferredRewards")
  notifications      Notification[]
  notificationPreference NotificationPreference?
  carts              Cart[]
  chats              Chat[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  title      String?
  recipient  String
  phone      String
  province   String
  city       String
  address    String
  postalCode String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  products    Product[]
  parentId    String?
  parent      Category?  @relation("SubCats", fields: [parentId], references: [id])
  children    Category[] @relation("SubCats")
}

model Product {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  englishName     String?
  description     String?
  specifications  String?
  sku             String                @unique
  brandId         String?
  categoryId      String
  purchaseCost    Int                   @default(0)
  price           Int
  oldPrice        Int?
  stock           Int                   @default(0)
  minStock        Int                   @default(2)
  expiryDate      DateTime?
  earlyExpiry     Boolean               @default(false)
  isNew           Boolean               @default(false)
  bestseller      Boolean               @default(false)
  featured        Boolean               @default(false)
  active          Boolean               @default(true)
  seoTitle        String?
  metaDescription String?
  keywords        String?
  altText         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  brand           Brand?                @relation(fields: [brandId], references: [id])
  category        Category              @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  reviews         Review[]
  questions       ProductQuestion[]
  inventory       InventoryTransaction[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  value      String
  sku        String?  @unique
  price      Int?
  stock      Int      @default(0)
  expiryDate DateTime?
  imageUrl   String?
  attributes Json?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  type           DiscountType
  value          Int
  minOrder       Int?
  startsAt       DateTime?
  endsAt         DateTime?
  firstOrderOnly Boolean            @default(false)
  active         Boolean            @default(true)
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
}

model Order {
  id                 String                @id @default(cuid())
  number             String                @unique
  userId             String?
  status             OrderStatus           @default(PENDING)
  subtotal           Int
  discount           Int                   @default(0)
  shippingFee        Int                   @default(0)
  total              Int
  source             String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User?                 @relation(fields: [userId], references: [id])
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  shipment           Shipment?
  returns            ReturnRequest[]
  couponRedemptions  CouponRedemption[]
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  productId  String
  variantId  String?
  name       String
  quantity   Int
  unitPrice  Int
  costAtSale Int
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Int
  status        PaymentStatus @default(PENDING)
  gateway       String?
  transactionId String?
  createdAt     DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id           String   @id @default(cuid())
  orderId      String   @unique
  method       String
  fee          Int
  trackingCode String?
  handedAt     DateTime?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  status      ReturnStatus @default(PENDING)
  reason      String
  description String?
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id])
}

model InventoryTransaction {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  oldQty    Int
  delta     Int
  newQty    Int
  reason    InventoryReason
  note      String?
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
}

model Reservation {
  id        String             @id @default(cuid())
  sessionId String
  expiresAt DateTime
  active    Boolean            @default(true)
  items     ReservationItem[]
}

model ReservationItem {
  id            String      @id @default(cuid())
  reservationId String
  productId     String
  variantId     String?
  quantity      Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  body       String?
  verified   Boolean  @default(false)
  approved   Boolean  @default(false)
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model ProductQuestion {
  id        String          @id @default(cuid())
  productId String
  userId    String
  body      String
  approved  Boolean         @default(false)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  answers   ProductAnswer[]
}

model ProductAnswer {
  id         String          @id @default(cuid())
  questionId String
  body       String
  isStore    Boolean         @default(false)
  approved   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ReferralCode {
  id      String           @id @default(cuid())
  userId  String
  code    String           @unique
  enabled Boolean          @default(false)
  user    User             @relation(fields: [userId], references: [id])
  rewards ReferralReward[]
}

model ReferralReward {
  id             String       @id @default(cuid())
  referralCodeId String
  referrerId     String
  referredUserId String
  orderId        String?
  percent        Int          @default(10)
  createdAt      DateTime     @default(now())
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])
  referrer       User         @relation("ReferrerRewards", fields: [referrerId], references: [id])
  referredUser   User         @relation("ReferredRewards", fields: [referredUserId], references: [id])
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  email  Boolean @default(true)
  sms    Boolean @default(true)
  push   Boolean @default(true)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chat {
  id        String        @id @default(cuid())
  userId    String?
  status    String        @default("waiting")
  createdAt DateTime      @default(now())
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  sender    String
  body      String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model SearchEvent {
  id        String   @id @default(cuid())
  query     String
  userId    String?
  results   Int
  createdAt DateTime @default(now())
}

model RecommendationEvent {
  id        String   @id @default(cuid())
  productId String
  type      String
  event     String
  userId    String?
  createdAt DateTime @default(now())
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  href      String?
  sort      Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  type      String
  active    Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
}

model PriceChangeHistory {
  id         String   @id @default(cuid())
  scope      String
  percentage Float
  rounding   Int?
  changedBy  String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Visit {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  source    String?
  medium    String?
  campaign  String?
  createdAt DateTime @default(now())
}

model AbandonedCart {
  id         String            @id @default(cuid())
  cartId     String
  detectedAt DateTime          @default(now())
  recovered  Boolean           @default(false)
  attempts   RecoveryAttempt[]
}

model RecoveryAttempt {
  id             String        @id @default(cuid())
  abandonedCartId String
  channel        String
  sentAt         DateTime      @default(now())
  clicked        Boolean       @default(false)
  abandonedCart  AbandonedCart @relation(fields: [abandonedCartId], references: [id], onDelete: Cascade)
}
